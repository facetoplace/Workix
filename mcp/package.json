{
  "name": "@workix/mcp",
  "version": "0.3.2",
  "description": "Remote jobs, freelance gigs and vacancies from 24 boards — Upwork, Freelancer.com, hh.ru, Kwork, RemoteOK, WeWorkRemotely, Adzuna and more — for AI agents over MCP. Search, digest, draft proposals and prepare apply steps; plus the Workix hub of startups, open roles and performers. Board adapters run locally, so platform credentials never leave your machine. Hub: https://workix.co — agent docs: https://workix.co/agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "workix-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "platforms.json",
    "presets.json",
    "profile.example.md",
    "telegram-channels.example.json",
    "TELEGRAM.md",
    "TELEGRAM-CHANNELS.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "pack:adapters": "node scripts/pack-adapters.mjs",
    "build:all": "npm run build && npm run pack:adapters",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "validate:tg-channels": "node scripts/validate-telegram-channels.mjs",
    "smoke": "npm run build && node scripts/smoke-preset.mjs mobile_dev",
    "smoke:startups": "npm run build && node scripts/smoke-preset.mjs startups_products",
    "smoke:hub": "node scripts/smoke-hub.mjs",
    "upwork:token": "node scripts/upwork-token.mjs",
    "tg:login": "node scripts/tg-login.mjs",
    "hh:login": "npm run build && node scripts/hh-login.mjs",
    "hh:check": "node scripts/hh-login.mjs --check",
    "hh:capture": "node scripts/hh-capture.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "workix",
    "freelance",
    "jobs",
    "vacancies",
    "job-search",
    "job-board",
    "remote-work",
    "remote-jobs",
    "work-from-home",
    "gigs",
    "hiring",
    "career",
    "ai-agents",
    "cursor",
    "claude",
    "upwork",
    "freelancer",
    "hh",
    "headhunter",
    "kwork",
    "freelancehunt",
    "remoteok",
    "remotive",
    "weworkremotely",
    "himalayas",
    "adzuna",
    "jobicy",
    "arbeitnow",
    "themuse",
    "working-nomads",
    "aquent",
    "telegram"
  ],
  "author": "Workix <mail@workix.co>",
  "homepage": "https://workix.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facetoplace/Workix.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/facetoplace/Workix/issues"
  },
  "license": "MIT",
  "mcpName": "co.workix/mcp",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "https-proxy-agent": "^9.1.0",
    "kwork-api": "^1.3.3",
    "rss-parser": "^3.13.0",
    "socket.io-client": "^2.5.0",
    "socks-proxy-agent": "^10.1.0",
    "tar": "^7.4.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "prebuilt-tdlib": "^0.1008066.0",
    "puppeteer-core": "^24.43.1",
    "tdl": "^8.1.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
