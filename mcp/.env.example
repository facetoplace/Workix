# Workix hub (platform CRUD — not freelance adapters)
WORKIX_API=https://workix.co
WORKIX_AGENT_KEY=

# dStore catalog (optional; same API as official dstore-mcp)
# DSTORE_API_BASE=https://db.dstore.one
# DSTORE_API_KEY=

# Downloadable board adapters (default: https://workix.co/mcp/registry.json)
# WORKIX_MCP_REGISTRY=https://workix.co/mcp/registry.json
# WORKIX_MCP_DATA=./data
# WORKIX_MCP_DEBUG=1

# Local store — SQLite at $WORKIX_MCP_DATA/workix.db (needs Node >=22.5).
# The old store.json is imported once on first start and renamed .migrated.
# Board responses are cached in the same file, so a second MCP session searching
# the same thing reuses the first one's fetch instead of hitting ~25 boards again.
# Inspect and clean up with workix_store_status; bypass for one run with
# force_refresh:true on workix_digest / workix_search.
# WORKIX_CACHE_TTL_MIN=12              # default TTL in minutes for sources with no override
# WORKIX_CACHE_TTL_JOBSPIPE=360        # per-source override: metered board, hold results long
# WORKIX_CACHE_TTL_REDDIT=0            # 0 disables caching for that source
# WORKIX_JOB_TTL_DAYS=30               # prune cards older than this, unless shared/drafted/applied

# Kwork
KWORK_LOGIN=
KWORK_PASSWORD=
KWORK_PHONE4=

# Freelancehunt
FREELANCEHUNT_TOKEN=

# Upwork OAuth2 — P0 (https://www.upwork.com/developer/keys/apply)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
UPWORK_REDIRECT_URI=http://127.0.0.1:3456/callback
UPWORK_TEAM_ORG_ID=
UPWORK_TENANT_ID=
UPWORK_CONTRACTOR_ID=
UPWORK_ODESK_USER_ID=
UPWORK_SEARCH=VPN OR WireGuard OR Flutter OR mobile OR React Native

# Freelancer.com — P0 (https://developers.freelancer.com)
FREELANCER_OAUTH_TOKEN=
FREELANCER_SEARCH=VPN OR WireGuard OR Flutter OR mobile OR Android OR iOS

# HH.ru official API (include_jobs / platform hh) — https://dev.hh.ru/ + https://github.com/hhru/api
# Search: registered app + User-Agent `AppName/ver (email)`; without → /vacancies 403.
# Apply (not in MCP yet): applicant OAuth user token → POST negotiations / apply-to-vacancy.
# HH_USER_AGENT=WorkixMCP/0.1 (you@example.com)
# HH_APP_TOKEN=
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_ACCESS_TOKEN=
# HH_REFRESH_TOKEN=

# include_jobs — Remotive / Arbeitnow / Himalayas / WWR / Jobicy / Dream Offer / AI Dev Jobs / Aquent (no keys) + Adzuna (optional)
# REMOTIVE_CATEGORY=software-dev
# ARBEITNOW_REMOTE_ONLY=1
# WWR_CATEGORY=programming
# JOBICY_TAG=dev
# JOBICY_GEO=
# Dream Offer (find.dreamoffer.app) — no API key; apply = source URL (TG/ATS)
# DREAMOFFER_PROFESSION=Mobile
# DREAMOFFER_WORK_FORMAT=remote
# DREAMOFFER_LANG=ru
# DREAMOFFER_SCAN_EXTRA=40

# WORKING_NOMADS_CATEGORY=
# THEMUSE_CATEGORY=
# FOUR_DAY_WEEK_REMOTE_ONLY=1
# AIDEV_WORKPLACE=remote
# AIDEV_TAGS=
# AIDEV_Q=
# AIDEV_API_KEY=
# AIDEV_POSTED_WITHIN_DAYS=30
# AQUENT_REMOTE_ONLY=1
# OPENWORK_OPEN_ONLY=1
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=gb
# ADZUNA_WHAT=mobile OR android OR ios OR flutter OR typescript
# ADZUNA_WHERE=

# include_jobs, no keys — Trudvsem (RU gov) / NoFluff (PL-EU) / Landing.jobs (PT-EU)
# / Get on Board (LATAM) / Djinni (UA) / Jobspresso / Reddit / employer ATS boards.
# Nothing to enable: these run on include_jobs. The vars below only tune them.
# Trudvsem: text is matched as a phrase, so digest keywords run as separate queries.
# TRUDVSEM_TEXT=разработчик
# TRUDVSEM_REGION=7700000000000
# TRUDVSEM_MAX_QUERIES=3
# NOFLUFF_CATEGORY=backend
# NOFLUFF_REGION=pl
# NOFLUFF_REMOTE_ONLY=1
# LANDING_JOBS_REMOTE_ONLY=1
# GETONBRD_QUERY=developer
# GETONBRD_REMOTE_ONLY=1
# Dice (US tech-only) is reached through its own MCP server and needs no key — it
# answers tools/call anonymously. These only narrow the search.
# DICE_KEYWORD=developer
# DICE_REMOTE_ONLY=1
# DICE_SPONSOR_ONLY=1
# Workopia (ATS aggregation, 90+ countries) also speaks MCP, but gates tools/call
# behind a free account. There is NO api key to paste — it is OAuth with dynamic
# client registration, so run `npm run workopia:login` once; the grant lands in
# mcp/data/workopia-tokens.json and refreshes itself. WORKOPIA_TOKEN below is only
# an escape hatch for a bearer token obtained some other way.
# WORKOPIA_TOKEN=
# Its job_tool requires a city (empty = nothing, not "everywhere"). Falls back to
# `city:` or the `Гео / язык:` line in mcp/profile.md, so you may not need this.
# "Remote"/"Worldwide" pass through verbatim; there is no documented wildcard.
# WORKOPIA_CITY=Berlin
# WORKOPIA_CALLBACK_PORT=51987
# getmatch has no server-side search, so keywords are filtered over a page we pull
# in full — this is how many of its 750 cards to read (default 100).
# GETMATCH_LIMIT=100
# HN "Who is hiring?" — defaults to the current month's thread. Set an item id to
# read a specific one, e.g. last month's.
# HN_HIRING_STORY=48747976
# Habr Career reads the frontend JSON (salary/grade/skills) and falls back to RSS.
# HABR_CAREER_REMOTE_ONLY=0
# Employer career boards straight from the ATS (Greenhouse/Ashby/Lever/SmartRecruiters/
# Workable). Default company list: mcp/ats-companies.json — this overrides it.
# ATS_COMPANIES=greenhouse:stripe,ashby:linear,lever:leverdemo

# Optional JobSpy bridge — Indeed, LinkedIn, Google Jobs, Glassdoor, ZipRecruiter, Bayt,
# Naukri, BDjobs. Opt-in: name the platform, e.g. platforms:["linkedin"]. Needs your own
# install: pip install -U python-jobspy on Python 3.10-3.12 (numpy 1.26.3 won't build on
# 3.13). Point this at that interpreter — optional if a suitable python is first on PATH.
# PYTHON_BIN=/abs/path/.jobspy/bin/python
# LinkedIn omits the body from search results; 1 fetches it at one extra request per card.
# JOBSPY_LINKEDIN_DESCRIPTIONS=1

# include_jobs, free key required — the board stays dark until the key is set
# JobsPipe — LinkedIn · Indeed · Y Combinator · Greenhouse · Lever · Ashby ·
# SmartRecruiters · Workday · Workable · Paylocity (39 feeds, one schema).
# Key: https://jobspipe.dev/agent — the dashboard calls it JOBS_PIPE_KEY.
# METERED: 1 credit = 1 job RETURNED. Free tier 1000/mo, then $49 / 25k.
# Because of that it does NOT run on a bare include_jobs. Use it deliberately:
#   workix_jobspipe_search   — aimed query, reports what it spent
#   workix_jobspipe_usage    — credits left this month (local counter)
#   workix_company_tech_stack — free, does not touch the job quota
# JOBS_PIPE_KEY=
# JOBSPIPE_API_KEY=                    # alias, same thing
# JOBSPIPE_IN_DIGEST=1                 # opt in to every include_jobs run
# JOBSPIPE_LIMIT=25                    # rows per call = credits per call
# JOBSPIPE_MONTHLY_BUDGET=1000         # adapter refuses to spend past this
# JOBSPIPE_TITLES=Flutter Developer,Mobile Engineer
# JOBSPIPE_EXCLUDE_TITLES=Recruiter,Sales
# JOBSPIPE_COMPANIES=
# JOBSPIPE_SKILLS=flutter,react-native
# JOBSPIPE_LOCATIONS=
# JOBSPIPE_COUNTRIES=US,GB,DE
# JOBSPIPE_SOURCES=linkedin,greenhouse # only these feeds
# JOBSPIPE_EXCLUDE_SOURCES=
# JOBSPIPE_SENIORITY=
# JOBSPIPE_EMPLOYMENT_TYPES=
# JOBSPIPE_WORK_ARRANGEMENTS=
# JOBSPIPE_REMOTE_ONLY=1
# JOBSPIPE_MAX_AGE_DAYS=14
# USAJOBS (US federal): https://developer.usajobs.gov/apirequest/
# Both are required — the key alone gets 403, the email goes in User-Agent.
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=you@example.com
# USAJOBS_KEYWORD=software
# USAJOBS_REMOTE_ONLY=1
# SuperJob (RU) official API 2.0: https://api.superjob.ru/
# 2026-08-09: 403 to datacenter IPs before auth — from a VPS this needs PROXY_1.
# SUPERJOB_APP_ID=
# SUPERJOB_KEYWORD=flutter
# SUPERJOB_TOWN=
# SUPERJOB_REMOTE_ONLY=1
# Careerjet (~90 countries incl. ru/ua/kz): https://www.careerjet.com/partners/
# CAREERJET_AFFID=
# CAREERJET_LOCALE=ru_RU
# CAREERJET_KEYWORDS=developer
# CAREERJET_LOCATION=
# Jooble (70+ countries): https://jooble.org/api/about — key goes in the URL path
# JOOBLE_API_KEY=
# JOOBLE_KEYWORDS=developer
# JOOBLE_LOCATION=

# Startup leads (kind=lead, NOT vacancies) — Product Hunt launches.
# Opt-in only: platforms:["producthunt"]; never pulled on a bare include_jobs.
# WORKS WITHOUT A KEY: falls back to the public Atom feed (50 launches).
# The token only buys richer cards (website, topics, makers) via GraphQL:
# https://api.producthunt.com/v2/docs → API dashboard → developer token
# (does not expire). That endpoint bills by complexity: 6250 points / 15 min.
# PRODUCTHUNT_TOKEN=
# PRODUCTHUNT_LIMIT=20        # launches per run (max 50)
#
# Product Hunt alternatives → leads. Keyless, opt-in: platforms:["launches"].
# Show HN (HN Algolia API) + r/SideProject Atom.
# LAUNCHES_LIMIT=30           # cards per run (max 100)
#
# Asia — public APIs, no keys, pulled on include_jobs like any other board:
#   wantedly  (JP startup hiring)  · no settings
#   kalibrr   (PH/SEA)             · KALIBRR_TEXT, KALIBRR_LIMIT (max 100)
#   instahyre (IN tech)            · INSTAHYRE_LIMIT (max 100)
# KALIBRR_TEXT=
# KALIBRR_LIMIT=40
# INSTAHYRE_LIMIT=50
#
# Funding news → leads. Keyless, opt-in: platforms:["funding"].
# Defaults to 5 feeds (Crunchbase News, TechCrunch Venture, Tech.eu, EU-Startups,
# Sifted). Override with feed ids or full URLs, comma-separated.
# FUNDING_FEEDS=crunchbase_news,tech_eu,https://example.com/feed
# FUNDING_LIMIT=40            # cards per run (max 200)
#
# StartupRanking → leads. Keyless, opt-in: platforms:["startupranking"].
# Cloudflare: direct requests are 403, so this one NEEDS PROXY_1 — the adapter
# rotates exits until one clears the challenge. Country pages did not clear as of
# 2026-08-11; retry them by pointing the path at one.
# STARTUPRANKING_PATH=/       # e.g. /top/country/russia
# STARTUPRANKING_LIMIT=50     # cards per run (max 100)

# include_agent_gigs — Growth.Talent / Claw Earn / SeekClaw / RentAHuman (public)
# + Superteam Earn (register: POST https://superteam.fun/api/agents → apiKey)
# SUPERTEAM_EARN_API_KEY=
# SUPERTEAM_EARN_BASE=https://superteam.fun
# SUPERTEAM_EARN_TYPE=
# GROWTH_TALENT_REMOTE=1
# GROWTH_TALENT_Q=
# CLAW_EARN_TAB=available

# Fiverr — no API key. Browser watch only: complete Seller Onboarding + active Gig + Get Briefs.
# Session cookies stay in Cursor browser (never put access_token here). See docs/10-platforms.md → Fiverr.

# Optional Telegram — see mcp/TELEGRAM.md
# Windows ARM64: npm install telegram  (GramJS). TDLib prebuilt не поддерживает win-arm64.
# 1) npm install telegram
# 2) api_id + api_hash from https://my.telegram.org/apps
# 3) npm run tg:login   ← phone/code/2FA in terminal (NOT in chat)
# 4) restart MCP → workix_tg_status / workix_tg_search
# TG_APP_API_ID=
# TG_APP_API_HASH=
# TELEGRAM_API_ID=          # aliases of TG_APP_*
# TELEGRAM_API_HASH=
# WORKIX_TG_CHANNELS=
# How many channels one digest run reads (default 12, max 40). They are taken by
# priority (high → medium → low), community chats excluded. Raise it when the
# watch list has more high-priority feeds than fit — each channel is one request,
# and a long sweep runs into Telegram flood-waits.
# WORKIX_TG_MAX_CHANNELS=12

