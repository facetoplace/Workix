# Workix hub (platform CRUD — not freelance adapters)
WORKIX_API=https://workix.co
WORKIX_AGENT_KEY=

# dStore catalog (optional; same API as official dstore-mcp)
# DSTORE_API_BASE=https://db.dstore.one
# DSTORE_API_KEY=

# Downloadable board adapters (default: https://workix.co/mcp/registry.json)
# WORKIX_MCP_REGISTRY=https://workix.co/mcp/registry.json
# WORKIX_MCP_DATA=./data
# WORKIX_MCP_DEBUG=1

# Kwork
KWORK_LOGIN=
KWORK_PASSWORD=
KWORK_PHONE4=

# Freelancehunt
FREELANCEHUNT_TOKEN=

# Upwork OAuth2 — P0 (https://www.upwork.com/developer/keys/apply)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
UPWORK_REDIRECT_URI=http://127.0.0.1:3456/callback
UPWORK_TEAM_ORG_ID=
UPWORK_TENANT_ID=
UPWORK_CONTRACTOR_ID=
UPWORK_ODESK_USER_ID=
UPWORK_SEARCH=VPN OR WireGuard OR Flutter OR mobile OR React Native

# Freelancer.com — P0 (https://developers.freelancer.com)
FREELANCER_OAUTH_TOKEN=
FREELANCER_SEARCH=VPN OR WireGuard OR Flutter OR mobile OR Android OR iOS
