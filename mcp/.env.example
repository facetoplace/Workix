# Workix hub (platform CRUD — not freelance adapters)
WORKIX_API=https://workix.co
WORKIX_AGENT_KEY=

# dStore catalog (optional; same API as official dstore-mcp)
# DSTORE_API_BASE=https://db.dstore.one
# DSTORE_API_KEY=

# Downloadable board adapters (default: https://workix.co/mcp/registry.json)
# WORKIX_MCP_REGISTRY=https://workix.co/mcp/registry.json
# WORKIX_MCP_DATA=./data
# WORKIX_MCP_DEBUG=1

# Kwork
KWORK_LOGIN=
KWORK_PASSWORD=
KWORK_PHONE4=

# Freelancehunt
FREELANCEHUNT_TOKEN=

# Upwork OAuth2 — P0 (https://www.upwork.com/developer/keys/apply)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
UPWORK_REDIRECT_URI=http://127.0.0.1:3456/callback
UPWORK_TEAM_ORG_ID=
UPWORK_TENANT_ID=
UPWORK_CONTRACTOR_ID=
UPWORK_ODESK_USER_ID=
UPWORK_SEARCH=VPN OR WireGuard OR Flutter OR mobile OR React Native

# Freelancer.com — P0 (https://developers.freelancer.com)
FREELANCER_OAUTH_TOKEN=
FREELANCER_SEARCH=VPN OR WireGuard OR Flutter OR mobile OR Android OR iOS

# HH.ru official API (include_jobs / platform hh) — https://dev.hh.ru/ + https://github.com/hhru/api
# Search: registered app + User-Agent `AppName/ver (email)`; without → /vacancies 403.
# Apply (not in MCP yet): applicant OAuth user token → POST negotiations / apply-to-vacancy.
# HH_USER_AGENT=WorkixMCP/0.1 (you@example.com)
# HH_APP_TOKEN=
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_ACCESS_TOKEN=
# HH_REFRESH_TOKEN=

# include_jobs — Remotive / Arbeitnow / Himalayas / WWR / Jobicy / Dream Offer / AI Dev Jobs / Aquent (no keys) + Adzuna (optional)
# REMOTIVE_CATEGORY=software-dev
# ARBEITNOW_REMOTE_ONLY=1
# WWR_CATEGORY=programming
# JOBICY_TAG=dev
# JOBICY_GEO=
# Dream Offer (find.dreamoffer.app) — no API key; apply = source URL (TG/ATS)
# DREAMOFFER_PROFESSION=Mobile
# DREAMOFFER_WORK_FORMAT=remote
# DREAMOFFER_LANG=ru
# DREAMOFFER_SCAN_EXTRA=40

# WORKING_NOMADS_CATEGORY=
# THEMUSE_CATEGORY=
# FOUR_DAY_WEEK_REMOTE_ONLY=1
# AIDEV_WORKPLACE=remote
# AIDEV_TAGS=
# AIDEV_Q=
# AIDEV_API_KEY=
# AIDEV_POSTED_WITHIN_DAYS=30
# AQUENT_REMOTE_ONLY=1
# OPENWORK_OPEN_ONLY=1
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=gb
# ADZUNA_WHAT=mobile OR android OR ios OR flutter OR typescript
# ADZUNA_WHERE=

# include_agent_gigs — Growth.Talent / Claw Earn / SeekClaw / RentAHuman (public)
# + Superteam Earn (register: POST https://superteam.fun/api/agents → apiKey)
# SUPERTEAM_EARN_API_KEY=
# SUPERTEAM_EARN_BASE=https://superteam.fun
# SUPERTEAM_EARN_TYPE=
# GROWTH_TALENT_REMOTE=1
# GROWTH_TALENT_Q=
# CLAW_EARN_TAB=available

# Fiverr — no API key. Browser watch only: complete Seller Onboarding + active Gig + Get Briefs.
# Session cookies stay in Cursor browser (never put access_token here). See docs/10-platforms.md → Fiverr.

# Optional Telegram — see mcp/TELEGRAM.md
# Windows ARM64: npm install telegram  (GramJS). TDLib prebuilt не поддерживает win-arm64.
# 1) npm install telegram
# 2) api_id + api_hash from https://my.telegram.org/apps
# 3) npm run tg:login   ← phone/code/2FA in terminal (NOT in chat)
# 4) restart MCP → workix_tg_status / workix_tg_search
# TG_APP_API_ID=
# TG_APP_API_HASH=
# TELEGRAM_API_ID=          # aliases of TG_APP_*
# TELEGRAM_API_HASH=
# WORKIX_TG_CHANNELS=

